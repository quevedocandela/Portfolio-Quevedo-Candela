---
import { skills } from "../data/site";
const acentos = ["coral", "cyan", "lime", "violet"];
---

<section class="section" id="skills">
  <div class="container">
    <div class="arcane-card" data-reveal>
      <svg class="arcane-art art-estrellas" viewBox="0 0 400 200" aria-hidden="true">
        <path d="M60 40 L66 58 L84 60 L70 72 L74 90 L60 79 L46 90 L50 72 L36 60 L54 58 Z" />
        <path d="M330 30 L334 42 L346 44 L337 52 L340 64 L330 57 L320 64 L323 52 L314 44 L326 42 Z" />
        <path d="M220 130 L225 145 L240 147 L228 157 L232 172 L220 163 L208 172 L212 157 L200 147 L215 145 Z" />
        <path d="M370 130 L373 139 L382 141 L375 147 L377 156 L370 151 L363 156 L365 147 L358 141 L367 139 Z" />
        <path d="M20 150 L23 159 L32 161 L25 167 L27 176 L20 171 L13 176 L15 167 L8 161 L17 159 Z" />
      </svg>
      <div class="arcane-content">
        <div class="arcane-head">
          <span class="arcane-numeral">III</span>
          <div>
            <h2 class="arcane-name">Las Estrellas</h2>
            <p class="arcane-sub">Habilidades técnicas</p>
          </div>
        </div>

        <div class="skills-grid">
          {skills.map((grupo, i) => (
            <div class="skill-group">
              <p class={`skill-key tok-${acentos[i % acentos.length]}`}>"{grupo.categoria}"</p>
              <ul class="skill-list">
                {grupo.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .art-estrellas {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    stroke-width: 1.4;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 28px;
  }

  .skill-key {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin: 0 0 14px;
  }

  .tok-coral { color: var(--coral); }
  .tok-cyan { color: var(--cyan); }
  .tok-lime { color: var(--lime); }
  .tok-violet { color: var(--violet); }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skill-list li {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
    padding-left: 18px;
    position: relative;
  }

  .skill-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }
</style>