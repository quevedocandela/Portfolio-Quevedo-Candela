<canvas id="starfield" aria-hidden="true"></canvas>

<div class="planet planet-1" aria-hidden="true"></div>
<div class="planet planet-2" aria-hidden="true"></div>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .planet {
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: -1;
    filter: blur(0.3px);
  }

  .planet-1 {
    top: 12%;
    left: 78%;
    width: 90px;
    height: 90px;
    background: radial-gradient(circle at 32% 32%, #e8c99a, #b9843f 60%, #6b4a24 100%);
    box-shadow: 0 0 40px rgba(227, 184, 115, 0.25);
    animation: float-1 22s ease-in-out infinite;
  }

  .planet-2 {
    top: 70%;
    left: 8%;
    width: 46px;
    height: 46px;
    background: radial-gradient(circle at 35% 30%, #cbb9f0, #8a6fd6 65%, #4c3a86 100%);
    box-shadow: 0 0 28px rgba(138, 111, 214, 0.3);
    animation: float-2 26s ease-in-out infinite;
  }

  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-18px, 22px); }
  }

  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(16px, -18px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .planet { animation: none; }
  }

  @media (max-width: 700px) {
    .planet-1 { width: 56px; height: 56px; }
    .planet-2 { width: 32px; height: 32px; }
  }
</style>

<script>
  const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    type Star = {
      x: number;
      y: number;
      r: number;
      baseAlpha: number;
      phase: number;
      twinkleSpeed: number;
      driftX: number;
      driftY: number;
    };
    let stars: Star[] = [];

    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      if (!canvas || !ctx) return;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const density = 0.00011;
      const count = Math.round(width * height * density);
      stars = Array.from({ length: count }, () => {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 0.05 + 0.01; // desplazamiento lento, tipo "viaje espacial"
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 1.4 + 0.3,
          baseAlpha: Math.random() * 0.5 + 0.35,
          phase: Math.random() * Math.PI * 2,
          twinkleSpeed: Math.random() * 0.6 + 0.2,
          driftX: Math.cos(angle) * speed,
          driftY: Math.sin(angle) * speed,
        };
      });
    }

    function draw(time: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      targetX += (mouseX - targetX) * 0.02;
      targetY += (mouseY - targetY) * 0.02;
      const offsetX = (targetX - width / 2) * 0.01;
      const offsetY = (targetY - height / 2) * 0.01;

      for (const s of stars) {
        if (!prefersReducedMotion) {
          s.x += s.driftX;
          s.y += s.driftY;
          if (s.x < -5) s.x = width + 5;
          if (s.x > width + 5) s.x = -5;
          if (s.y < -5) s.y = height + 5;
          if (s.y > height + 5) s.y = -5;
        }

        const twinkle = prefersReducedMotion
          ? s.baseAlpha
          : s.baseAlpha + Math.sin(time * 0.001 * s.twinkleSpeed + s.phase) * 0.25;

        ctx.beginPath();
        ctx.fillStyle = `rgba(243, 236, 255, ${Math.max(0, Math.min(1, twinkle))})`;
        ctx.arc(s.x + offsetX, s.y + offsetY, s.r, 0, Math.PI * 2);
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    resize();
    requestAnimationFrame(draw);
  }
</script>