---
import { perfil } from "../data/site";
---

<section class="hero" id="top">
  <svg class="emblem" viewBox="0 0 200 200" aria-hidden="true">
    <g class="emblem-rays">
      {Array.from({ length: 12 }).map((_, i) => (
        <line
          x1="100"
          y1="18"
          x2="100"
          y2="34"
          transform={`rotate(${i * 30} 100 100)`}
        />
      ))}
    </g>
    <circle class="emblem-sun" cx="100" cy="100" r="46" />
    <path
      class="emblem-moon"
      d="M132 62a54 54 0 1 0 0 76 44 44 0 0 1 0-76Z"
    />
  </svg>

  <div class="container hero-inner">
    <p class="pill">
      <span class="pulse" aria-hidden="true"></span>
      disponible para nuevas oportunidades
    </p>

    <h1 class="hero-title">{perfil.nombre}</h1>
    <p class="hero-role">{perfil.rol}</p>
    <p class="hero-tagline">{perfil.tagline}</p>

    <div class="hero-actions">
      <a class="btn btn-solid" href="#proyectos">Ver proyectos</a>
      <a class="btn btn-ghost" href={perfil.cvUrl} download>Descargar CV</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 72px 0 64px;
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .emblem {
    position: absolute;
    top: 50%;
    right: -6%;
    width: min(60vw, 560px);
    height: auto;
    transform: translateY(-50%);
    opacity: 0.16;
    pointer-events: none;
    z-index: 0;
  }

  .emblem-rays {
    stroke: var(--lime);
    stroke-width: 2;
    animation: spin 90s linear infinite;
    transform-origin: 100px 100px;
  }

  .emblem-sun {
    fill: none;
    stroke: var(--lime);
    stroke-width: 1.5;
  }

  .emblem-moon {
    fill: none;
    stroke: var(--violet);
    stroke-width: 1.5;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .emblem-rays { animation: none; }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--violet);
    box-shadow: 0 0 0 0 rgba(211, 132, 235, 0.5);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(156, 7, 255, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(127, 248, 111, 0); }
    100% { box-shadow: 0 0 0 0 rgba(121, 248, 71, 0); }
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.05;
    margin-top: 10px;
    max-width: 14ch;
  }

  .hero-role {
    font-family: var(--font-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: var(--lime);
    margin: 0;
  }

  .hero-tagline {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--text-muted);
    max-width: 46ch;
    margin: 6px 0 0;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
</style>