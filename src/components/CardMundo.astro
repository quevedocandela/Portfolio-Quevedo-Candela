---
import { proyectos } from "../data/site";
---

<button class="tcard" data-id="mundo" style="--card-accent:var(--cyan)" aria-label="Abrir El Mundo">
  <span class="tcard-vines" aria-hidden="true"></span>
  <span class="tcard-stars" aria-hidden="true"></span>
  <span class="tcard-glow" aria-hidden="true"></span>
  <span class="corner corner-tl"></span>
  <span class="corner corner-tr"></span>
  <span class="corner corner-bl"></span>
  <span class="corner corner-br"></span>
  <svg class="tcard-icon" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="58" />
    <ellipse cx="100" cy="100" rx="24" ry="58" />
    <ellipse cx="100" cy="100" rx="58" ry="24" transform="rotate(20 100 100)" />
    <line x1="42" y1="100" x2="158" y2="100" />
  </svg>
  <span class="tcard-numeral">II</span>
  <span class="tcard-name">El Mundo</span>
</button>

<div class="tpanel" data-panel-for="mundo">
  <div class="tpanel-card">
    <span class="corner corner-tl"></span>
    <span class="corner corner-tr"></span>
    <span class="corner corner-bl"></span>
    <span class="corner corner-br"></span>
    <button class="tpanel-close" aria-label="Cerrar">✕</button>

    <div class="tpanel-scroll">
      <div class="tpanel-fit">
        <p class="tpanel-eyebrow">II · El Mundo</p>
        <h2 class="tpanel-title">Proyectos</h2>
        {proyectos.map((p) => (
          <div class="tpanel-project">
            <p class="tpanel-project-name">{p.nombre}</p>
            <p class="tpanel-p">{p.descripcion}</p>
            <ul class="tpanel-tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
            <div class="tpanel-links">
              {p.repoUrl ? (
                <a href={p.repoUrl} target="_blank" rel="noopener noreferrer">Código</a>
              ) : (
                <span class="tpanel-link-pending">Visitar proyecto →</span>
              )}
              {p.demoUrl && <a href={p.demoUrl} target="_blank" rel="noopener noreferrer">Demo</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>